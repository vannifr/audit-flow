{
  "name": "audit-orchestration",
  "version": "1.0.0",
  "description": "Temporal-based application audit orchestration",
  "main": "lib/workflows/index.js",
  "types": "lib/workflows/index.d.ts",
  "scripts": {
    "build": "tsc --build",
    "start": "ts-node src/worker.ts",
    "workflow": "ts-node src/client.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:bdd": "cucumber-js",
    "test:all": "npm run test && npm run test:bdd",
    "lint": "eslint src --ext .ts"
  },
  "dependencies": {
    "@temporalio/activity": "^1.24.0",
    "@temporalio/client": "^1.24.0",
    "@temporalio/common": "^1.24.0",
    "@temporalio/worker": "^1.24.0",
    "@temporalio/workflow": "^1.24.0",
    "axios": "^1.6.0",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "@cucumber/cucumber": "^13.2.1",
    "@types/node": "^20.10.0",
    "@types/uuid": "^9.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^8.0.0",
    "ts-node": "^10.9.0",
    "typescript": "^5.3.0",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "license": "MIT"
}
